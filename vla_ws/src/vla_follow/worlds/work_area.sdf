<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="follow_world">

    <physics name="fast" type="ignored">
      <!-- P84: 步长从 0.003 收到 0.001。原来 3ms 的步长对"只有轮子的车"够用,
           但加了 20 个 12g 手指关节(惯量 2e-4)后, 力控伺服在 3ms 步长下
           一个步长就能把角速度推上千 rad/s —— 求解器直接发散, 表现为
           "桌面上的水壶水杯无缘无故被掀飞 2~5m""七轴臂永远追不上目标"。
           降步长是所有轻质多关节模型的常规操作, 代价是 CPU x3。 -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- DRINK:BEGIN world_ext -->
    <!-- P86 抓取附着: 世界内插件, 把 attach 过的物体每 tick 钉到掌心 -->
    <plugin filename="libGraspCarry.so" name="vla::GraspCarry">
      <topic>/drink/carry</topic>
      <ack_topic>/drink/carry/ack</ack_topic>
      <debug>1</debug>
    </plugin>
<!-- DRINK:END world_ext -->

    <scene>
      <ambient>0.62 0.62 0.62 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- cast_shadows=false: 消除地板上的暗色阴影(会被人检测的暗色先验误判为"人") -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- GUI: 全局俯视机位只保留**一处来源** —— ~/.gz/sim/8/gui.config 的
         MinimalScene/camera_pose(由 vla_demo/gz_gui_fix.py 每次启动重写)。
         P76c: 原来这里还写了 <camera name="user_cam">(16m), 与 gui.config 的
         13m 抢同一个机位, 且 view_controller=orbit 让相机容易跟着"选中实体"跑
         (配合 CameraTracking 时 25s/50s/90s 三帧从全景缩到近景)。已删除,
         只留 gui.config 一处, 相机端行为才可预测。
         相机画面小窗(ImageDisplay)同样在 gui.config 中(需在 3D View 之后加载才能锚定)。 -->
    <gui fullscreen="false"/>

    <!-- 大地面(工作区外) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material><ambient>0.42 0.5 0.42 1</ambient><diffuse>0.42 0.5 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 工作区地板 12m x 12m -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12.3 12.3 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12.3 12.3 0.1</size></box></geometry>
          <material><ambient>0.78 0.79 0.81 1</ambient><diffuse>0.78 0.79 0.81 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 工作区围墙(内侧边界 ±6m) -->
    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>0 6.075 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.3 0.15 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12.3 0.15 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>0 -6.075 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.3 0.15 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12.3 0.15 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>6.075 0 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 12.3 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 12.3 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>-6.075 0 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 12.3 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 12.3 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障碍物 -->
