        </visual>
      </link>
      <link name="right_wheel">
        <pose relative_to="skirt">0 -0.20 -0.225 1.5707 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
