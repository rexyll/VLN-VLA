        </visual>
      </link>
      <link name="caster">
        <pose relative_to="skirt">-0.18 0 -0.25 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.000036</ixx><iyy>0.000036</iyy><izz>0.000036</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
