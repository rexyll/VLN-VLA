    <model name="kettle">
      <pose>2.30000 0.20000 0.80300 0.0000 0.0000 1.5708</pose>
      <link name="body">
        <!-- P86: 关重力。抓取附着由世界内的 GraspCarry 插件每 tick 写
             WorldPoseCmd 完成, 它只管位置不管速度; 若重力照常作用, 两次
             teleport 之间物体仍被加速, 松手瞬间残余速度会让它飞出去。
             关掉之后壶既不会被拽走, 也不会积累速度, 松手就停在原地 ——
             正是"放回桌面原位置"需要的语义。机械臂的 link 同理。 -->
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 -0.02 0 0 0</pose>
          <mass>0.42</mass>
          <inertia><ixx>0.0026</ixx><iyy>0.0026</iyy><izz>0.0012</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
<!-- P86: 碰撞体与任何东西都不碰撞(collide_bitmask=0)。壶/杯是运动学
             驱动的(抓握期间由 GraspCarry 每 tick 钉到掌心), 碰撞体只会在钉住
             期间跟手指反复挤压、把接触冲量攒成速度, 一松钉就随机弹开 5~7mm。
             重力已关, 摆位全走 teleport, 去掉碰撞不改变可见行为。 -->
        <collision name="c_body">
          <pose>0.00000 0.00000 0.00000 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0680</radius><length>0.1600</length></cylinder></geometry>
          <collide_bitmask>0x00</collide_bitmask>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v_body">
          <pose>0.00000 0.00000 0.00000 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0680</radius><length>0.1600</length></cylinder></geometry>
          <material>
            <ambient>0.86 0.88 0.90 1</ambient>
            <diffuse>0.86 0.88 0.90 1</diffuse>
          </material>
        </visual>
        <visual name="v_ring">
          <pose>0.00000 0.00000 0.06000 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0700</radius><length>0.0140</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.34 0.38 1</ambient>
            <diffuse>0.30 0.34 0.38 1</diffuse>
          </material>
        </visual>
        <visual name="v_lid">
          <pose>0.00000 0.00000 0.08600 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0544</radius><length>0.0160</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.22 0.25 1</ambient>
            <diffuse>0.20 0.22 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="v_knob">
          <pose>0.00000 0.00000 0.10200 0.0000 0.0000 0.0000</pose>
          <geometry><sphere><radius>0.0130</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.13 0.15 1</ambient>
            <diffuse>0.12 0.13 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="v_water">
          <pose>0.00000 0.00000 -0.02880 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0612</radius><length>0.0880</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.55 0.85 1</ambient>
