      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>R_pan_joint</joint_name>
        <topic>/drink/cmd/R_pan_joint</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>30.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>1.6</d_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
