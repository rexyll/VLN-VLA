        </visual>
      </link>
      <link name="ob5">
        <pose>4.2 -3.0 0.6 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 1.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 1.2</size></box></geometry>
          <material><ambient>0.56 0.39 0.81 1</ambient><diffuse>0.56 0.39 0.81 1</diffuse></material>
        </visual>
      </link>
      <link name="ob6">
        <pose>-1.5 -4.5 0.25 0 0 -0.4</pose>
        <collision name="c"><geometry><box><size>1.0 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.0 0.5 0.5</size></box></geometry>
          <material><ambient>0.27 0.51 0.56 1</ambient><diffuse>0.27 0.51 0.56 1</diffuse></material>
        </visual>
      </link>
      <link name="ob7">
        <pose>2.2 4.6 0.45 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.88 0.69 0.25 1</ambient><diffuse>0.88 0.69 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 机器人: 双轮差速 + 前向 GPU 激光雷达, 初始位于原点 -->
    <model name="robot" canonical_link="chassis">
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
      <link name="chassis">
        <pose>0 0 0.13 0 0 0</pose>
        <inertial>
          <mass>4.0</mass>
          <inertia><ixx>0.0167</ixx><iyy>0.0333</iyy><izz>0.0433</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.30 0.20 0.10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.30 0.20 0.10</size></box></geometry>
          <material><ambient>0.15 0.35 0.8 1</ambient><diffuse>0.15 0.35 0.8 1</diffuse></material>
        </visual>
        <!-- P76: 急停圈(r=0.66, lidar_stop_m) —— 障碍进入此盘即硬停 -->
        <visual name="stop_zone_v">
          <pose>0 0 -0.12 0 0 0</pose>
          <geometry><cylinder><radius>0.660</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>1 0.15 0.1 1</ambient>
            <diffuse>1 0.15 0.1 1</diffuse>
            <emissive>0.35 0.02 0.0 1</emissive>
