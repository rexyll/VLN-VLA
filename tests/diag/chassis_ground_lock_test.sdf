<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Dedicated fixed-joint test world: no ApplyLinkWrench or wheel-brake plugin. -->
  <world name="brake_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="robot" canonical_link="chassis">
      <pose>0 0 0 0 0 0</pose>
      <link name="chassis">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>13.0</mass>
          <inertia>
            <ixx>0.0841</ixx><iyy>0.1361</iyy><izz>0.1985</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body">
          <geometry><box><size>0.34 0.26 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.34 0.26 0.10</size></box></geometry>
        </visual>
      </link>

      <link name="left_wheel">
        <pose relative_to="chassis">0 0.15 -0.09 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="wheel">
          <geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry>
        </visual>
      </link>
      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.15 -0.09 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="wheel">
          <geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="chassis">0 0.15 -0.09 0 0 0</pose>
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><effort>5.0</effort></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="chassis">0 -0.15 -0.09 0 0 0</pose>
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><effort>5.0</effort></limit></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_radius>0.06</wheel_radius>
        <topic>/model/robot/cmd_vel</topic>
        <odom_topic>/model/robot/odometry</odom_topic>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-0.8</min_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <min_angular_acceleration>-3.0</min_angular_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <update_rate>100</update_rate>
      </plugin>
    </model>
  
    <!-- Static world anchor. DetachableJoint connects this link to robot::chassis. -->
    <model name="ground_lock_anchor">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>
      <!-- No collision geometry: DART requires attached parent/child models
           not to overlap in their initial attached configuration. -->
      <link name="ground_lock_anchor_link">
        <pose>0 0 0 0 0 0</pose>
      </link>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>ground_lock_anchor_link</parent_link>
        <child_model>robot</child_model>
        <child_link>chassis</child_link>
        <attach_topic>/world/brake_test/chassis_lock/attach</attach_topic>
        <detach_topic>/world/brake_test/chassis_lock/detach</detach_topic>
        <output_topic>/world/brake_test/chassis_lock/state</output_topic>
      </plugin>
    </model>
  </world>
</sdf>
