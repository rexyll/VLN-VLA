<?xml version="1.0"?>
<sdf version="1.9">
  <model name="grasp_carry_plugin_host">
    <static>true</static>
    <link name="host_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <plugin filename="libGraspCarry.so" name="vla::GraspCarry">
      <topic>/drink/carry</topic>
      <ack_topic>/drink/carry/ack</ack_topic>
      <debug>false</debug>
    </plugin>
  </model>
</sdf>
